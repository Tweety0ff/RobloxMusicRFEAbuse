local statusToken = 0
local function showStatus(text)
	local token = statusToken + 1
	statusToken = token
	statusLabel.Text = text
	task.delay(3, function()
		if statusToken == token then
			statusLabel.Text = ""
		end
	end)
end

local dropdownOpen = false

local function setDropdown(open)
	dropdownOpen = open
	dropdownArrow.Text = open and "▲" or "▼"

	if open then
		dropdownList.Visible = true
		local targetHeight = listItems.Size.Y.Offset + listPadding.PaddingTop.Offset + listPadding.PaddingBottom.Offset
		
		dropdownList.Size = UDim2.new(1, 0, 0, 0)
		TweenService:Create(dropdownList, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(1, 0, 0, targetHeight)
		}):Play()
	else
		TweenService:Create(dropdownList, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(1, 0, 0, 0)
		}):Play()
		task.delay(0.15, function()
			if not dropdownOpen then
				dropdownList.Visible = false
			end
		end)
	end
end

