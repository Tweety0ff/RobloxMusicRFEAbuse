local statusToken = 0
local function showStatus(text, color)
	local token = statusToken + 1
	statusToken = token
	statusLabel.Text = text
	if color then
		statusLabel.TextColor3 = color
	else
		statusLabel.TextColor3 = Color3.fromRGB(52, 211, 153) 
	end
	task.delay(3, function()
		if statusToken == token then
			statusLabel.Text = ""
		end
	end)
end

local function closeGuiAnimation()
	local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	
	local closeTween = TweenService:Create(mainFrame, tweenInfo, {
		GroupTransparency = 1,
		Size = UDim2.new(0, 1, 0, 1)
	})
	
	closeTween:Play()
	
	closeTween.Completed:Connect(function()
		if screenGui then
			screenGui:Destroy()
		end
	end)
end

local function safeLoad(url)
	local success, result = pcall(function()
		return game:HttpGet(url)
	end)

	if not success then
		showStatus("Error: HTTP request failed", Color3.fromRGB(255, 85, 85))
		warn("HTTP Request failed: " .. tostring(result))
		return false
	end

	if result:match("404: Not Found") then
		showStatus("Error: File not found (404)", Color3.fromRGB(255, 85, 85))
		warn("GitHub returned 404 for URL: " .. url)
		return false
	end

	local func, err = loadstring(result)
	if type(func) ~= "function" then
		showStatus("Error: Script syntax invalid", Color3.fromRGB(255, 85, 85))
		warn("Loadstring Error (check file syntax): " .. tostring(err))
		return false
	end

	local execSuccess, execErr = pcall(func)
	if not execSuccess then
		showStatus("Error: Execution failed", Color3.fromRGB(255, 85, 85))
		warn("Execution Error: " .. tostring(execErr))
		return false
	end

	return true
end

