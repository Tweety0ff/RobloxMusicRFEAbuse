local layoutOrderCounter = 0

local function addLog(version, date, changesArray)
	layoutOrderCounter = layoutOrderCounter + 1
	
	local logEntry = Instance.new("Frame")
	logEntry.Name = "Log_" .. version
	logEntry.Parent = scrollFrame
	logEntry.BackgroundTransparency = 1
	logEntry.Size = UDim2.new(1, -8, 0, 0)
	logEntry.AutomaticSize = Enum.AutomaticSize.Y
	logEntry.LayoutOrder = layoutOrderCounter
	
	local logLayout = Instance.new("UIListLayout")
	logLayout.Parent = logEntry
	logLayout.Padding = UDim.new(0, 6)
	logLayout.SortOrder = Enum.SortOrder.LayoutOrder
	
	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.Parent = logEntry
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, 20)
	header.Font = Enum.Font.GothamBold
	header.Text = "v" .. version .. "  •  " .. date
	header.TextColor3 = Color3.fromRGB(255, 255, 255)
	header.TextSize = 14
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.LayoutOrder = 1
	

	for i, changeText in ipairs(changesArray) do
		local point = Instance.new("TextLabel")
		point.Name = "Point_" .. i
		point.Parent = logEntry
		point.BackgroundTransparency = 1
		point.Size = UDim2.new(1, 0, 0, 0)
		point.AutomaticSize = Enum.AutomaticSize.Y
		point.Font = Enum.Font.GothamSemibold
		point.Text = "— " .. changeText
		point.TextColor3 = Color3.fromRGB(200, 205, 210)
		point.TextSize = 12
		point.TextXAlignment = Enum.TextXAlignment.Left
		point.TextWrapped = true
		point.LayoutOrder = i + 1
	end
end

