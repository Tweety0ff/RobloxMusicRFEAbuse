local function switchTab(tabName)
	currentTab = tabName
	local isMain = (tabName == "Main")
	mainPage.Visible = isMain
	settingsPage.Visible = not isMain
	mainTabButton.BackgroundTransparency = isMain and 0.6 or 0.75
	settingsTabButton.BackgroundTransparency = isMain and 0.75 or 0.6
end

