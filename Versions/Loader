-- logic stuff
local tkn = 0
local function setStatus(txt, c)
	tkn = tkn + 1
	local cur_tkn = tkn
	statLabel.Text = txt
	if c then statLabel.TextColor3 = c else statLabel.TextColor3 = Color3.fromRGB(52, 211, 153) end
	
	task.delay(3, function()
		if tkn == cur_tkn then statLabel.Text = "" end
	end)
end

local function doCloseAnim()
	local tw = ts:Create(mainFr, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
		GroupTransparency = 1,
		Size = UDim2.new(0, 1, 0, 1)
	})
	tw:Play()
	tw.Completed:Connect(function()
		if scr then scr:Destroy() end
	end)
end

local function doLoadNew()
	local url = "https://raw.githubusercontent.com/Tweety0ff/RobloxMusicRFEAbuse/refs/heads/main/Versions/Last"
	local ok, err_msg = pcall(function() loadstring(game:HttpGet(url))() end)
	
	if ok then
		setStatus("Last Version Loaded ✓")
		task.delay(0.01, doCloseAnim)
	else
		setStatus("Error loading script", Color3.fromRGB(255, 85, 85))
		
	end
end

local function doLoadOld()
	task.delay(0.01, doCloseAnim)
	local ok, err_msg = pcall(function()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/Tweety0ff/RobloxMusicRFEAbuse/refs/heads/main/Versions/1.0(old%20ui)"))()
	end)
	
	if ok then
		setStatus("Version 1.0 Loaded ✓")
	else
		setStatus("Error loading script", Color3.fromRGB(255, 85, 85))
	end
end

